# Скопируйте в engine/.env и заполните ключи. Дефолты — в engine/config.py (класс Settings).
# Полное описание переменных — docs/DEVELOPER_ONBOARDING.md, §8.

# --- Провайдер LLM ---
LLM_PROVIDER=deepseek                  # deepseek | anthropic | cloudru

# --- Cloud.ru Foundation Models (текст + отдельный OCR сканов) ---
# секрет сервисного ключа Cloud.ru
CLOUDRU_API_KEY=
CLOUDRU_BASE_URL=https://foundation-models.api.cloud.ru/v1
CLOUDRU_MODEL_FAST=deepseek-ai/DeepSeek-V4-Flash
CLOUDRU_MODEL_SMART=deepseek-ai/DeepSeek-V4-Flash
CLOUDRU_MODEL_OCR=deepseek-ai/DeepSeek-OCR-2
CLOUDRU_SPEC_READER=vision             # vision (по умолчанию) | ocr (прежний OCR2)
CLOUDRU_VISION_VERIFY=false            # второй платный проход по фрагментам; пока не проверен на Cloud.ru
CLOUDRU_MODEL_VISION=qwen/qwen3-vl-30b-a3b-instruct

# --- DeepSeek (активный провайдер; OpenAI-совместимый, с vision) ---
# обязателен при LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_VISION=deepseek-flash     # исходные изображения; текстовые модели отдельно
DEEPSEEK_MODEL_SMART=deepseek-chat
DEEPSEEK_MODEL_FAST=deepseek-chat

# --- Anthropic (альтернативный провайдер с vision) ---
ANTHROPIC_API_KEY=
MODEL_SMART=claude-opus-4-8            # ID устарели — обновить перед переключением на anthropic
MODEL_FAST=claude-sonnet-4-6

# --- Реквизиты организации-продавца по ИНН ---
# dadata.ru, есть бесплатный тариф
DADATA_TOKEN=

# S3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Выдача поисковика: SERP-API XMLRiver (XML Яндекса без капчи) ---
XMLRIVER_USER=
XMLRIVER_KEY=
XMLRIVER_URL=https://xmlriver.com/search_yandex/xml
XMLRIVER_LR=213                        # код региона Яндекса, 213 = Москва

# --- Официальный Yandex Search API (не используется, оставлено про запас) ---
YANDEX_SEARCH_API_KEY=
YANDEX_SEARCH_FOLDER_ID=

# --- Параметры поиска цен ---
MIN_SOURCES=5                          # минимум валидных офферов на позицию
TOP_PRICES=3                           # сколько максимальных цен берём в КАЦ/ТКП
PRIMARY_SEARCH_SECONDS=90              # мягкий лимит основного списка, затем резерв
POSITION_SEARCH_SECONDS=150            # мягкий лимит всей позиции; текущая карточка может завершиться позже
VAT_RATE=22                            # НДС, %; графа H КАЦ = G / (1 + VAT_RATE/100)
REGION=Москва и Московская область

# производители уникального оборудования (цена из писем, онлайн-поиск не нужен), через «;»
CUSTOM_MAKERS=

# --- Браузер ---
# false = headless (штатно). true — если Яндекс просит капчу: разово запустить с true,
# решить капчу в окне → cookie сохранятся в data/cache/cookies.json, вернуть false.
BROWSER_HEADED=false

# --- (Опц.) Ресурсы для скриншота карточки реквизитов по ИНН, через «;»; {inn} — подстановка ---
# REQUISITES_SOURCES=https://www.audit-it.ru/contragent/{inn};https://sbis.ru/contragents/{inn}
